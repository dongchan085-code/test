# Hugging Face Settings
HF_TOPIC=LLM

# LLM API Settings (using Google Gemini via google-genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email Delivery Settings (Optional)
# Leave empty if you only want RSS
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
RECEIVER_EMAIL=your_email@gmail.com

# Instagram -> Google Drive Settings
IG_TARGET_PROFILE=garambakerycafe
IG_DOWNLOAD_LIMIT=10
# IG_USERNAME / IG_PASSWORD are optional but recommended to avoid Instagram rate limits
IG_USERNAME=
IG_PASSWORD=
# Google Drive folder name to upload videos into (defaults to IG_TARGET_PROFILE)
GDRIVE_FOLDER_NAME=
